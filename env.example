# Zabbix frontend/API base URL. Either form works:
#   https://zabbix.example.com
#   https://zabbix.example.com/api_jsonrpc.php
ZABBIX_URL=https://zabbix.example.com

# --- Authentication: use ONE of the two methods below -----------------
# Option 1 (preferred): API token created in
# Administration > General > API tokens
ZABBIX_TOKEN=

# Option 2 (fallback): username + password
ZABBIX_USER=
ZABBIX_PASSWORD=
# -----------------------------------------------------------------------

# Optional. Default output file if --output is not passed on the CLI.
ZABBIX_OUTPUT=inventario.xlsx

# Optional. Set to "false" ONLY for trusted internal/self-signed Zabbix
# servers where you cannot install a proper CA-signed certificate.
# Traffic stays encrypted either way; this only disables verifying the
# server's identity. Defaults to "true".
ZABBIX_VERIFY_SSL=true
